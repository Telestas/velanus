rules_version = '2';

/**
 * Reglas de seguridad de Firestore.
 *
 * El sitio es estático y no hay servidor propio: el navegador habla directo con
 * Firestore. Esto es, por tanto, la única puerta que protege los datos. Todo lo
 * que no esté permitido aquí, no se puede hacer, venga de donde venga.
 *
 * Quién es admin: quien tenga un documento en `admins/{su-uid}`. Esa colección
 * no se puede escribir desde el navegador —ni siquiera siendo admin—, solo con
 * credenciales de servidor (la CLI de Firebase). Así nadie puede ascenderse a
 * sí mismo aunque se cuele en el panel.
 */
service cloud.firestore {
  match /databases/{database}/documents {

    function esAdmin() {
      return request.auth != null
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    function texto(campo, minimo, maximo) {
      return campo is string && campo.size() >= minimo && campo.size() <= maximo;
    }

    /** Lista de administradores. Se siembra desde la CLI, nunca desde la web. */
    match /admins/{uid} {
      allow read: if esAdmin();
      allow write: if false;
    }

    /**
     * Entradas del blog. Las publicadas las lee cualquiera; los borradores,
     * solo el admin. El listado público debe filtrar por `publicada == true`,
     * porque una consulta sin ese filtro pediría también los borradores y
     * Firestore la rechazaría entera.
     */
    match /entradas/{id} {
      allow read: if resource.data.publicada == true || esAdmin();
      allow create, update, delete: if esAdmin();
    }

    /** Preguntas frecuentes: mismo trato que las entradas. */
    match /preguntas/{id} {
      allow read: if resource.data.publicada == true || esAdmin();
      allow create, update, delete: if esAdmin();
    }

    /**
     * Marca de tiempo puesta por el cliente.
     *
     * El sitio público escribe por la API REST (para no cargar el SDK, que son
     * ~165 kB), y por REST no existe `serverTimestamp()`. Se acepta la hora del
     * cliente siempre que sea reciente y no esté en el futuro: basta para
     * ordenar, y quien manipule su reloj solo se descoloca a sí mismo.
     */
    function fechaRazonable(valor) {
      return valor is timestamp
        && valor <= request.time
        && valor > request.time - duration.value(10, 'm');
    }

    /**
     * Comentarios de los lectores.
     *
     * **Moderación previa**: nacen con `aprobado: false` y solo el admin puede
     * aprobarlos. Sin Cloud Functions (exige plan Blaze) no hay filtro
     * automático, y publicar al instante en el sitio de un despacho es pedir
     * que el primer bot escriba por él.
     *
     * Lectura: cualquiera ve los aprobados. El listado público debe filtrar por
     * `aprobado == true`, porque una consulta sin ese filtro pediría también los
     * pendientes y Firestore la rechazaría entera.
     */
    match /comentarios/{id} {
      allow read: if resource.data.aprobado == true || esAdmin();

      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly(
             ['entrada', 'nombre', 'correo', 'texto', 'creado', 'autor',
              'aprobado', 'respuesta'])
        && request.resource.data.keys().hasAll(
             ['entrada', 'nombre', 'texto', 'creado', 'autor', 'aprobado'])
        && request.resource.data.autor == request.auth.uid
        && request.resource.data.aprobado == false
        && fechaRazonable(request.resource.data.creado)
        && texto(request.resource.data.entrada, 1, 200)
        && texto(request.resource.data.nombre, 2, 60)
        && texto(request.resource.data.texto, 2, 2000);

      // El admin aprueba y, si quiere, responde. Nadie edita el texto ajeno.
      allow update: if esAdmin()
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['aprobado', 'respuesta']);
      allow delete: if esAdmin();
    }

    /**
     * Reseñas de clientes. Mismo trato que los comentarios: se envían para
     * revisión y no aparecen hasta que el admin las aprueba.
     */
    match /resenas/{id} {
      allow read: if resource.data.aprobada == true || esAdmin();

      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly(
             ['nombre', 'pais', 'servicio', 'estrellas', 'texto', 'creado',
              'autor', 'aprobada'])
        && request.resource.data.keys().hasAll(
             ['nombre', 'servicio', 'estrellas', 'texto', 'creado', 'autor',
              'aprobada'])
        && request.resource.data.autor == request.auth.uid
        && request.resource.data.aprobada == false
        && fechaRazonable(request.resource.data.creado)
        && request.resource.data.estrellas is int
        && request.resource.data.estrellas >= 1
        && request.resource.data.estrellas <= 5
        && texto(request.resource.data.nombre, 2, 60)
        && texto(request.resource.data.servicio, 2, 80)
        && texto(request.resource.data.texto, 10, 1500);

      allow update: if esAdmin()
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['aprobada']);
      allow delete: if esAdmin();
    }

    /**
     * Consultas del formulario de diagnóstico y del de contacto.
     *
     * Son datos personales de posibles clientes: **nadie puede leerlas salvo
     * el admin**, ni siquiera quien las escribió. Se crean sin más trámite
     * —pedir registro para consultar sería perder clientes— con la misma
     * validación de forma que los comentarios.
     */
    match /consultas/{id} {
      allow read, update, delete: if esAdmin();

      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly(
             ['nombre', 'empresa', 'telefono', 'correo', 'servicio', 'pais',
              'mensaje', 'origen', 'creado', 'atendida'])
        && request.resource.data.keys().hasAll(
             ['nombre', 'origen', 'creado', 'atendida'])
        && request.resource.data.atendida == false
        && request.resource.data.creado == request.time
        && texto(request.resource.data.nombre, 2, 120)
        && texto(request.resource.data.origen, 2, 40);
    }

    /**
     * Ajustes del sitio que la firma edita desde el panel. Hoy solo
     * `sitio/cifras` (entidades constituidas, clientes atendidos, países de
     * origen y profesionales en el equipo).
     *
     * Lectura pública: son datos de escaparate y los pinta el sitio para
     * cualquier visitante. Escritura, solo admin.
     */
    match /sitio/{documento} {
      allow read: if true;
      allow write: if esAdmin();
    }

    /** Todo lo demás queda cerrado. */
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
