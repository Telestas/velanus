{
  "indexes": [
    {
      "//": "Portada del blog y listado: entradas publicadas, de la más nueva a la más vieja.",
      "collectionGroup": "entradas",
      "queryScope": "COLLECTION",
      "fields": [
        { "fieldPath": "publicada", "order": "ASCENDING" },
        { "fieldPath": "fecha", "order": "DESCENDING" }
      ]
    },
    {
      "//": "Índice anterior de comentarios; mantener durante la transición.",
      "collectionGroup": "comentarios",
      "queryScope": "COLLECTION",
      "fields": [
        { "fieldPath": "entrada", "order": "ASCENDING" },
        { "fieldPath": "creado", "order": "ASCENDING" }
      ]
    },
    {
      "//": "Comentarios aprobados de una entrada, en orden de publicación.",
      "collectionGroup": "comentarios",
      "queryScope": "COLLECTION",
      "fields": [
        { "fieldPath": "entrada", "order": "ASCENDING" },
        { "fieldPath": "aprobado", "order": "ASCENDING" },
        { "fieldPath": "creado", "order": "ASCENDING" }
      ]
    }
  ],
  "fieldOverrides": []
}
